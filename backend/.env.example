# Server configuration
PORT=5000

# If a system proxy blocks Google APIs, bypass it only for Firestore and
# Google service-account token requests (comma-separated hostname suffixes).
FIRESTORE_NO_PROXY_HOSTS=firestore.googleapis.com
GOOGLE_API_NO_PROXY_HOSTS=googleapis.com

# Firebase configuration (Admin SDK credentials)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email"
# Private key should contain the private key string (with \n replaced if in single line, or keep standard formatting)
FIREBASE_PRIVATE_KEY="your-service-account-private-key"

# Medicine grace period in minutes before a pending medicine is marked as missed
MEDICINE_GRACE_PERIOD_MIN=30

# Optional conversational assistant. Keys stay in backend/.env only.
ASSISTANT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Groq text generation and multilingual speech recognition.
# Keep this key exclusively in backend/.env; never add it to frontend files.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_REQUEST_TIMEOUT_MS=30000
